<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>NBA Playoff Race — __SEASON__</title>
<meta name="description" content="__OGDESC__">
<link rel="canonical" href="__PAGEURL__">
<meta name="theme-color" content="#070910">

<!-- Link previews on LinkedIn / X / WhatsApp / Slack. Every URL absolute, and each
     generated page carries its OWN url, title and description -- render.py fills these
     per file, so the towers page and the unplayed 2026-27 season do not claim to be the
     2025-26 film. Bump the ?v= on og.png to bust the caches. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="A Guy With A Scarf">
<meta property="og:title" content="__OGTITLE__">
<meta property="og:description" content="__OGDESC__">
<meta property="og:url" content="__PAGEURL__">
<meta property="og:image" content="https://nba.aguywithascarf.com/img/og.png?v=1">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="__OGALT__">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="__OGTITLE__">
<meta name="twitter:description" content="__OGDESC__">
<meta name="twitter:image" content="https://nba.aguywithascarf.com/img/og.png?v=1">

<!-- Read by the AGWAS capture extension at the moment you press the shortcut, and
     embedded into the PNG as the CTA / Tags / Mentions chunks for the Instagram caption
     and story card. These are DEFAULTS: updateSocialMeta() rewrites them on every card
     change, so a capture describes the card you are actually looking at. -->
<meta name="agwas:title"    content="__OGTITLE__">
<meta name="agwas:cta"      content="Full interactive NBA experience below">
<meta name="agwas:mentions" content="nba">
<meta name="agwas:tags"     content="nba dataviz basketball">
<meta name="agwas:bg"       content="https://nba.aguywithascarf.com/img/og.png">
<link rel="icon" href="favicon.svg">
<style>
:root{
  --bg:#070910; --ink:#e8ecf5; --dim:#8b96ad;
  --pan:rgba(255,255,255,.055); --pan2:rgba(255,255,255,.014);
  --line:rgba(150,166,205,.14);
  --acc:#e0453f; --gold:#f0c24a; --win:#43c07a; --loss:#e0554a;
  --bar:46px; --ctl:58px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--ink);
  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;font-weight:300;
  -webkit-font-smoothing:antialiased}
b{font-weight:700}

#topbar{position:fixed;top:0;left:0;right:0;height:var(--bar);z-index:40;display:flex;
  align-items:center;gap:12px;padding:0 16px;background:rgba(7,9,16,.9);
  backdrop-filter:blur(14px);border-bottom:1px solid var(--line);font-size:12px}
#ttl{color:var(--dim);white-space:nowrap;flex:0 0 auto}
#ttl b{color:var(--ink)}
.seg{display:flex;gap:5px;flex:0 0 auto}
.pill{border:1px solid var(--line);background:var(--pan2);color:var(--dim);
  border-radius:99px;padding:5px 12px;font-size:11.5px;cursor:pointer;text-decoration:none;
  display:inline-block}
.pill:hover{color:var(--ink);border-color:rgba(150,166,205,.3)}
.pill.on{background:var(--acc);border-color:var(--acc);color:#fff;font-weight:700}
.grow{flex:1 1 auto}
.lab{color:var(--dim);font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  margin-right:2px;flex:0 0 auto}

#wrap{position:fixed;top:var(--bar);bottom:var(--ctl);left:0;right:0;overflow:auto;
  padding:14px 16px 8px}

/* ---------- the playoff race ----------
   One bar per team: the wins it has, and -- faint, behind -- every win it could still
   reach. Two lines run through each conference, because the NBA has two cuts: the top
   six are in the playoffs, seven to ten go to the play-in. A team whose ghost can no
   longer reach tenth is out, and dims. The same design as the NHL season page, adapted:
   wins rather than points (no overtime losses in the NBA), and two cuts rather than one. */
body.race #wrap,body.reg #wrap{display:flex;flex-direction:column}

/* ---------- the regular season, every game ----------
   Thirty rows, one box per game: green for a win, red for a loss, the opponent's three
   letters in white inside. The first version staggered thin marks and coloured the codes
   in each opponent's colours, like a team card's axis -- it looked busy and hid the one
   thing the view is for, how each season went. Solid boxes read as a streak at a glance.
   Both are darkened so white letters clear 4.5:1 -- the green by 30%, since at 20% it
   only managed 3.5; the red by 20%, which already gives 5.5.
   Same order as the race, so the two views agree. */
.rghead{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:6px;flex:0 0 auto}
.rghead h2{font-size:clamp(17px,1.8vw,24px);font-weight:700;letter-spacing:-.015em}
.rghead p{font-size:11px;color:var(--dim)}
.rgkey{display:flex;gap:14px;flex-wrap:wrap;font-size:10.5px;color:var(--dim);margin-left:auto}
.rgkey i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.rggrid{flex:1 1 auto;min-height:0;display:flex;flex-direction:column}
.rgconf{flex:0 0 auto;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);
  padding:5px 0 3px;border-bottom:1px solid var(--line);margin-bottom:2px}
/* Name and record as large as the row will take: they are what a reader scans down
   for, and the boxes beside them only need room for three small letters. */
.rgrow{flex:1 1 0;min-height:21px;display:grid;align-items:stretch;gap:7px;
  grid-template-columns:16px 20px 54px 58px minmax(0,1fr);font-size:15px;line-height:1;
  font-variant-numeric:tabular-nums}
.rgrow > span,.rgrow > img{align-self:center}
.rgrow img{width:19px;height:19px;object-fit:contain;background:rgba(255,255,255,.07);border-radius:50%}
.rgrow .rk{color:var(--dim);text-align:right;font-size:10px}
.rgrow .ab{font-weight:700;letter-spacing:.01em;color:var(--ink);text-decoration:none;
  white-space:nowrap;border-bottom:1px dotted transparent}
.rgrow .ab:hover{border-bottom-color:currentColor}
.rgrow.champ .ab{color:var(--gold)}
.rgrow .rec{color:var(--dim);text-align:right}
.rgrow:hover{background:rgba(255,255,255,.03)}
.rgcells{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));
  grid-template-rows:minmax(0,1fr);gap:1px;min-width:0;align-items:center}
/* The cells fill the row's height. The rule above centres the row's labels, and caught
   this strip too -- which shrank every box to the height of its 6.5px text. */
.rgrow > .rgcells{align-self:stretch}
/* Boxes only as tall as their three letters, centred in the row: the row height is
   unchanged and the dark band between one team's season and the next is what separates
   them -- full-height boxes ran thirty rows together into one wall of colour. */
.rgc{display:grid;place-items:center;min-width:0;padding:2px 0;border-radius:2px;
  font-size:6.5px;line-height:1;font-weight:700;letter-spacing:-.02em;white-space:nowrap;
  overflow:hidden;color:#fff;font-style:normal}
.rgc.w{background:color-mix(in srgb,var(--win) 70%,#000)}
.rgc.l{background:color-mix(in srgb,var(--loss) 80%,#000)}
.rgc.u{background:rgba(150,166,205,.1);color:rgba(232,236,245,.42)}
.rgaxis{flex:0 0 auto;display:grid;gap:7px;grid-template-columns:16px 20px 54px 58px minmax(0,1fr);
  margin-bottom:1px}
.rgaxis .tx{position:relative;height:11px}
.rgaxis .tx span{position:absolute;transform:translateX(-50%);font-size:9px;color:var(--dim)}
@media (max-width:1100px){ .rgc{font-size:0} }
@media (max-width:900px){ body.reg #wrap{display:block} .rggrid,.rgaxis{min-width:860px} }
.rchead{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:12px}
.rchead h2{font-size:clamp(17px,1.8vw,24px);font-weight:700;letter-spacing:-.015em}
.rchead p{font-size:11.5px;color:var(--dim);max-width:110ch;line-height:1.5}
.rckey{display:flex;gap:14px;flex-wrap:wrap;font-size:10.5px;color:var(--dim);margin-left:auto}
.rckey i{display:inline-block;width:14px;height:8px;border-radius:2px;margin-right:5px;vertical-align:0}
.rcgrid{flex:1 1 auto;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:26px}
.rcconf{display:flex;flex-direction:column;min-height:0}
.rchd{display:flex;align-items:baseline;justify-content:space-between;font-size:10.5px;
  letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:6px;
  border-bottom:1px solid var(--line);padding-bottom:5px}
.rchd b{color:var(--ink);letter-spacing:.02em}
.rcrows{flex:1 1 auto;min-height:0;display:flex;flex-direction:column}
.rctabs{flex:0 0 auto}
.rctabs .pill{padding:4px 11px;font-size:11px}
/* A block title inside a panel (a division) and the lines drawn between rows where the
   playoff and play-in places end. Fixed heights, so the rows keep sharing what is left. */
.rcsub{flex:0 0 auto;padding:7px 0 2px 49px;font-size:9.5px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--dim)}
.rcsep{flex:0 0 auto;position:relative;height:11px}
.rcsep::before{content:'';position:absolute;left:49px;right:0;top:50%;
  border-top:1.5px dashed rgba(232,236,245,.55)}
.rcsep.pi::before{border-top-color:rgba(232,236,245,.28)}
.rcsep span{position:absolute;right:0;top:50%;transform:translateY(-50%);padding:0 0 0 7px;
  background:var(--bg);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink)}
.rcsep.pi span{color:var(--dim)}
.rcrow{flex:1 1 0;min-height:22px;display:grid;align-items:center;gap:9px;
  grid-template-columns:18px 22px 96px minmax(0,1fr) 52px 34px;font-size:12px;
  font-variant-numeric:tabular-nums;transition:opacity .2s}
.rcrow img{width:20px;height:20px;object-fit:contain;
  /* Brooklyn's and San Antonio's crests are black artwork; a faint disc keeps them. */
  background:rgba(255,255,255,.07);border-radius:50%}
.rcrow .rk{color:var(--dim);text-align:right;font-size:10.5px}
.rcrow .nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rcrow .rec{text-align:right;color:var(--dim);letter-spacing:.01em}
/* The bigger number bright, the other quiet -- see recHtml(). */
.rcrow .rec b,.rgrow .rec b{color:#fff;font-weight:700}
.rcrow .tag{font-size:9.5px;font-weight:700;letter-spacing:.06em;text-align:center;
  border-radius:4px;padding:2px 0;color:#ff8b84;
  border:1px solid color-mix(in srgb,var(--acc) 55%,transparent)}
/* Seeds seven to ten hold a play-in place, not a playoff one: dashed, and quieter. */
.rcrow .tag.pi{color:#c9b9b8;border-style:dashed;
  border-color:color-mix(in srgb,var(--acc) 32%,transparent)}
.rcrow .tag.none{border:none;color:transparent}
.rcrow.out{opacity:.38}
.rcrow.clinched .tag{background:color-mix(in srgb,var(--acc) 22%,transparent)}
.rcrow.champ .nm{color:var(--gold);font-weight:700}
.rcbar{position:relative;height:70%;max-height:19px;min-height:13px}
/* Wins and the ceiling, written INTO the bar: the wins just past the solid part, the most
   it can still reach at the far end of the stripes. A dark chip each, so the text
   survives any team colour and the stripes behind it. */
.rcbar b{position:absolute;top:50%;transform:translateY(-50%);z-index:3;white-space:nowrap;
  font-size:10px;line-height:1;font-weight:700;padding:2px 5px;border-radius:4px;
  background:rgba(7,9,16,.78);font-variant-numeric:tabular-nums}
.rcbar .rcpts{color:var(--ink)}
.rcbar .rcpts small{font-size:8.5px;font-weight:600;opacity:.7;margin-left:2px}
.rcbar .rcmax{color:rgba(232,236,245,.62);font-weight:600}
.rcbar .rcmaxin{color:rgba(232,236,245,.62);font-weight:600;margin-left:4px}
.rcbar > i{position:absolute;top:0;bottom:0;display:block}
.rcbar .gh{border-radius:0 3px 3px 0;background:repeating-linear-gradient(135deg,
  color-mix(in srgb,var(--c) 26%,transparent) 0 3px,transparent 3px 6px);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--c) 30%,transparent)}
.rcbar .w{background:var(--c);border-radius:3px 0 0 3px}
.rcbar .cut{top:-5px;bottom:-5px;width:0;border-left:1.5px dashed rgba(232,236,245,.7);z-index:2}
.rcbar .cut.pi{border-left-color:rgba(232,236,245,.32)}
.rcaxis{position:relative;height:13px;margin-bottom:2px}
.rcaxis span{position:absolute;transform:translateX(-50%);font-size:9px;color:var(--dim)}
.rcline{font-size:9.5px;color:var(--ink);letter-spacing:.04em;text-transform:none}
.rcline em{font-style:normal;color:var(--dim)}
@media (max-width:900px){
  .rcgrid{grid-template-columns:1fr;gap:18px}
  .rcrow{grid-template-columns:16px 18px 70px minmax(0,1fr) 46px 30px;font-size:11px;min-height:24px}
  .rckey{margin-left:0}
  body.race #wrap{display:block}
}

#ctlbar{position:fixed;bottom:0;left:0;right:0;height:var(--ctl);z-index:40;display:flex;
  align-items:center;gap:12px;padding:0 16px;background:rgba(7,9,16,.9);
  backdrop-filter:blur(14px);border-top:1px solid var(--line);
  padding-bottom:env(safe-area-inset-bottom)}
.ic{width:32px;height:32px;border-radius:9px;border:1px solid var(--line);
  background:var(--pan2);color:var(--dim);display:grid;place-items:center;cursor:pointer;
  flex:0 0 auto}
.ic:hover{color:var(--ink);background:var(--pan)}
.ic svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;
  stroke-linecap:round;stroke-linejoin:round}
.scrub{position:relative;flex:1 1 auto;display:flex;align-items:center;height:24px}
#slider{-webkit-appearance:none;appearance:none;width:100%;height:24px;margin:0;
  background:transparent;cursor:pointer}
#slider::-webkit-slider-runnable-track{height:4px;border-radius:999px;
  background:linear-gradient(90deg,var(--acc) calc(var(--pct,1) * 100%),
    rgba(150,166,205,.22) 0)}
#slider::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;
  border-radius:50%;background:var(--acc);border:2px solid #0b0e16;margin-top:-10px;
  box-shadow:0 1px 6px rgba(0,0,0,.5)}
#slider::-moz-range-track{height:4px;border-radius:999px;background:rgba(150,166,205,.22)}
#slider::-moz-range-progress{height:4px;border-radius:999px;background:var(--acc)}
#slider::-moz-range-thumb{width:24px;height:24px;border-radius:50%;background:var(--acc);
  border:2px solid #0b0e16;box-shadow:0 1px 6px rgba(0,0,0,.5)}
/* The game number rides the thumb. Pointer-events off so it never blocks a drag. */
#gdot{position:absolute;top:50%;transform:translate(-50%,-50%);pointer-events:none;
  font-size:9.5px;font-weight:800;color:#fff;font-variant-numeric:tabular-nums;
  letter-spacing:-.02em;text-shadow:0 1px 2px rgba(0,0,0,.45)}
#gno{font-size:12px;color:var(--dim);font-variant-numeric:tabular-nums;
  white-space:nowrap;flex:0 0 auto;min-width:118px}
#gno b{color:var(--ink)}

/* ---------- the playoff bracket ----------
   Sixteen teams, folded in from both sides: West on the left, East on the right, the
   Finals in the middle. Each column is an eight-row grid and a series spans 2, 4 or 8 of
   those rows, so a semi-final sits exactly between the two first-round series that fed
   it -- which is what makes the connectors drawable in CSS rather than measured.
   Round r spans 2^(r+1) rows; the gap between a pair's centres is that same span, so the
   vertical join is 2^(r+1)/8 of the column's height. */
/* A DEFINITE height, which is the whole trick: `repeat(8, 1fr)` in a grid whose own
   height is indefinite resolves every row to max-content, so the rows came out uneven
   and a semi-final no longer lined up between its two feeders. The flex column gives
   .brack a resolved height, and the rows can then actually be eighths of it. */
body.bracket #wrap{display:flex;flex-direction:column}
.brack{--gap:22px;display:grid;grid-template-columns:1fr minmax(230px,.74fr) 1fr;
  gap:var(--gap);flex:1 1 auto;min-height:520px}
.brside{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1fr) minmax(0,1.2fr);
  gap:var(--gap)}
.brside.r{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,.82fr)}
/* Each series is placed on its own centre line rather than by grid spans: a series in
   round r is one of 8/2^(r+1) slots, and the centre of slot i is (i + .5) of that slot's
   share of the column. Stated once, it makes a semi-final land exactly between its two
   feeders by arithmetic instead of by hoping align-self and a row span agree -- which
   they did not, leaving every other box a row out of place. */
.brcol{position:relative;min-width:0}
/* Round by round the box gets twice the vertical room, so the crest grows into it. */
.brcol.r0{--cr:min(5.6vh,2.6vw,50px)}
.brcol.r1{--cr:min(7vh,3.1vw,62px)}
.brcol.r2{--cr:min(8.4vh,3.7vw,74px)}
.brcol > .ser{position:absolute;left:0;right:0;transform:translateY(-50%)}
/* The connectors are the column's, not the boxes': a stub out to the gutter at each
   series' centre line, and one vertical joining each pair at the far edge of that
   gutter -- which is exactly where the next round's box begins. */
.brstub,.brjoin{position:absolute;pointer-events:none}
.brstub{width:var(--gap);border-top:1.5px solid var(--c,rgba(150,166,205,.3));
  box-shadow:0 0 9px -1px var(--c,transparent)}
.brjoin{border-left:1.5px solid rgba(150,166,205,.22)}
.brside.l .brstub,.brside.l .brjoin{right:calc(-1 * var(--gap))}
.brside.r .brstub,.brside.r .brjoin{left:calc(-1 * var(--gap))}
/* The Finals column is not a bracket column -- one series, centred, with the champion
   line under it. */
.brfin{display:flex;flex-direction:column;justify-content:center;gap:10px;min-width:0}
.brhd{display:grid;grid-template-columns:1fr minmax(230px,.74fr) 1fr;gap:var(--gap);
  margin-bottom:14px}
.brhd > div{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1fr) minmax(0,1.2fr);
  gap:var(--gap)}
.brhd > div:last-child{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,.82fr)}
.brhd span{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);
  text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brhd .fin{color:var(--gold);font-weight:700;font-size:12px;letter-spacing:.3em}

/* A series is a confrontation, so every one of them is drawn as one -- two crests
   facing each other with the score between, the winner in full colour and the loser
   drained of his. Names were being cut to "T... 4" because a bracket column is narrow
   and a long nickname is not; a crest needs no width to be recognised, which is what
   lets the badge get big. The Finals is the same composition, four times the size. */
.ser{position:relative;min-width:0;border-radius:14px;overflow:hidden;
  border:1px solid var(--line);background:linear-gradient(180deg,#11151f,#0b0f16);
  padding:11px 9px 12px;transition:transform .16s,box-shadow .16s,border-color .16s}
.ser::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:var(--c,var(--line))}
.ser::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(85% 120% at var(--cx,50%) 100%,var(--c,transparent),transparent 70%);
  opacity:.17}
.ser:hover{transform:translateY(-2px);border-color:var(--c,var(--line));
  box-shadow:0 12px 34px -10px var(--c,#000)}
/* every series the champion played, so the road to the title can be traced across the
   page without reading a single name */
.ser.road{border-color:rgba(240,194,74,.38);
  box-shadow:0 0 0 1px rgba(240,194,74,.16),0 10px 30px -16px rgba(240,194,74,.5)}
.ser.road:hover{border-color:rgba(240,194,74,.75);
  box-shadow:0 14px 38px -12px rgba(240,194,74,.55)}
.brstub.road{border-top-width:2px;opacity:.95}
.ser > *{position:relative;z-index:1}

.duel{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);
  align-items:start;gap:5px}
.dside{display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0}
.dside img{width:var(--cr);height:auto;aspect-ratio:1;max-width:100%;object-fit:contain;
  filter:drop-shadow(0 4px 10px rgba(0,0,0,.65));transition:filter .2s,opacity .2s}
.dside b{font-size:min(calc(var(--cr) * .26),15px);font-weight:700;letter-spacing:.08em;
  text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  max-width:100%;line-height:1.1;text-align:center}
/* the seed, small enough to be a footnote and always there */
.dside i{font-style:normal;font-size:min(calc(var(--cr) * .19),11px);color:var(--dim);
  letter-spacing:.1em;line-height:1;opacity:.8}
/* knocked out: the crest stays, so the tie is still readable, but the colour goes */
.dside.out img{filter:grayscale(1) brightness(.72);opacity:.32}
.dside.out b{color:var(--dim);font-weight:300;letter-spacing:.04em}
.dsc{display:flex;align-items:baseline;gap:3px;font-variant-numeric:tabular-nums;
  font-size:min(calc(var(--cr) * .66),40px);font-weight:700;line-height:1;padding-top:calc(var(--cr) * .2)}
.dsc em{font-style:normal;font-size:.42em;color:var(--dim);font-weight:300}
.dsc .l{color:var(--dim);font-weight:300}
/* the games, as a row of bars in the colour of whoever took that night */
.sgames{display:flex;gap:3px;margin-top:9px;flex-wrap:nowrap}
.pog{flex:1 1 0;min-width:0;height:6px;border-radius:99px;cursor:default;
  transition:height .14s}
.ser:hover .pog{height:10px}

/* ---- the Finals: the same duel, given the room to shout ---- */
.brfin{position:relative}
.brfin::before{content:'';position:absolute;left:50%;top:50%;width:170%;height:150%;
  transform:translate(-50%,-50%);pointer-events:none;
  background:radial-gradient(closest-side,rgba(240,194,74,.14),transparent 72%)}
.ser.fin{border-color:rgba(240,194,74,.42);border-radius:22px;
  background:linear-gradient(180deg,#1b1608,#0b0f16 64%);padding:22px 20px 20px}
.ser.fin::before{display:none}
.ser.fin::after{background:radial-gradient(120% 95% at 50% 0%,rgba(240,194,74,.17),transparent 64%);
  opacity:1}
.ser.fin:hover{transform:none;box-shadow:0 20px 64px -22px rgba(240,194,74,.55)}
.duel.fin{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}
.finkick{text-align:center;font-size:10px;letter-spacing:.34em;text-transform:uppercase;
  color:var(--gold);font-weight:700;margin-bottom:12px;opacity:.9}
.ser.fin .dsc{justify-content:center;margin-top:14px;padding-top:0}
.ser.fin .dside b{font-size:clamp(11px,1.6vh,17px);letter-spacing:.16em}
.ser.fin .dside i{font-size:clamp(8.5px,1.1vh,11px)}
.ser.fin .dsc{font-size:clamp(30px,7.5vh,78px)}
.ser.fin .sgames{margin-top:17px}
.ser.fin .pog{height:9px}
.ser.fin:hover .pog{height:13px}
/* the champion line, in gold, under the stage */
.brchamp{text-align:center;margin-top:15px}
.brchamp .ttl{font-size:clamp(16px,2.8vh,28px);font-weight:700;letter-spacing:-.01em;
  color:var(--gold);line-height:1.1}
.brchamp .ring{display:inline-block;margin-right:9px;font-size:.62em;vertical-align:.16em;
  opacity:.9}
.brchamp .sub{font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);
  margin-top:7px}

/* the champion's crest, enormous and almost invisible, behind the whole bracket */
.brwash{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:min(74vh,820px);height:min(74vh,820px);pointer-events:none;z-index:0;
  opacity:.05;filter:grayscale(.15)}
.brack{position:relative}
.brack > *:not(.brwash){position:relative;z-index:1}

.brnone{color:var(--dim);font-size:13px;padding:30px 4px}
.brcap{font-size:10px;color:var(--dim);margin-top:10px;text-align:center}
body.bracket #ctlbar{display:none}
body.bracket #wrap{bottom:0}
/* Between a laptop and a phone the bracket still draws, but there is no width to spare:
   the rounds go back to equal columns, the gutters tighten, and the middle gives up the
   space it was using to make the Finals enormous. */
@media (max-width:1200px){
  .brack{--gap:14px;grid-template-columns:1fr minmax(180px,.5fr) 1fr}
  .brhd{grid-template-columns:1fr minmax(180px,.5fr) 1fr}
  .brside,.brside.r,.brhd > div,.brhd > div:last-child{
    grid-template-columns:repeat(3,minmax(0,1fr))}
  .brcol.r0{--cr:min(5.4vh,3.1vw,44px)}
  .brcol.r1{--cr:min(6.6vh,3.5vw,52px)}
  .brcol.r2{--cr:min(7.8vh,3.9vw,60px)}
  .ser{padding:9px 6px 10px}
  .dside b{letter-spacing:.03em}
  .brhd span{font-size:9px;letter-spacing:.14em}
}
@media (max-width:900px){
  /* A bracket needs width it does not have here, so the drawing gives way to the
     reading order: conference, round, series, in normal flow. The absolute placement
     that makes the connectors possible is exactly what collapses at this width -- four
     series on one column's centre lines land on top of each other -- so it comes off. */
  .brhd{display:none}
  .brack{display:flex;flex-direction:column;gap:22px;min-height:0}
  .brside,.brside.r{display:flex;flex-direction:column;gap:16px}
  .brcol{display:flex;flex-direction:column;gap:10px}
  .brcol > .ser{position:static!important;transform:none;top:auto!important}
  .brstub,.brjoin{display:none}
  .brside::before{content:attr(data-conf);font-size:11px;letter-spacing:.3em;
    text-transform:uppercase;color:var(--ink);font-weight:700}
  .brcol::before{content:attr(data-r);font-size:9.5px;letter-spacing:.22em;
    text-transform:uppercase;color:var(--dim)}
  .brcol.r0,.brcol.r1,.brcol.r2{--cr:min(15vw,62px)}
  .brwash{width:min(46vh,340px);height:min(46vh,340px)}
  .ser.fin{--cr:min(26vw,140px)}
  .ser.fin .dsc{font-size:clamp(30px,11vw,52px)}
  .brfin{order:-1}          /* the champion first: it is why you opened the page */
}

#tip{position:fixed;z-index:70;pointer-events:none;display:none;background:#0d1019;
  border:1px solid var(--line);border-radius:10px;padding:7px 10px;font-size:11.5px;
  box-shadow:0 8px 26px rgba(0,0,0,.5);white-space:nowrap}
#tip.on{display:block}
#tip .t{color:var(--dim);font-size:10px;letter-spacing:.06em;text-transform:uppercase}
#credit{color:var(--dim);font-size:11px;white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;flex:0 1 auto;margin-left:6px}
#credit a{color:var(--dim);text-decoration:none;border-bottom:1px solid var(--line)}
#credit a:hover{color:var(--ink)}
.mod{position:fixed;inset:0;z-index:60;background:rgba(4,6,12,.82);
  backdrop-filter:blur(7px);display:none;place-items:center;padding:22px}
.mod.on{display:grid}
.mbox{width:min(720px,94vw);max-height:84vh;overflow:auto;background:#0d1019;
  border:1px solid var(--line);border-radius:20px;padding:22px 24px}
.mbox h3{font-size:17px;font-weight:700;margin-bottom:12px}
.mbox p,.mbox li{font-size:12.5px;color:var(--dim);line-height:1.65}
.mbox ul{margin:8px 0 8px 17px}
kbd{font:inherit;font-size:11px;background:var(--pan);border:1px solid var(--line);
  border-radius:6px;padding:1px 6px;color:var(--ink)}
.applist{display:flex;flex-direction:column;gap:3px}
.approw{display:grid;grid-template-columns:12px 1fr auto;gap:11px;align-items:center;
  padding:9px 10px;border-radius:10px;text-decoration:none;color:var(--ink);font-size:12.5px}
.approw:hover{background:var(--pan)}
.approw i{width:9px;height:9px;border-radius:99px}
.approw em{font-style:normal;color:var(--dim);font-size:11px;display:block}
@media (max-width:760px){ .lab{display:none} #credit{display:none}
  #topbar{overflow-x:auto;overflow-y:hidden;scrollbar-width:none}
  #topbar::-webkit-scrollbar{display:none} }
</style>
<!-- Umami --><script>try{/[?&#]noumami\b/.test(location.href)&&localStorage.setItem('umami.disabled','1')}catch(e){}</script><script defer src="https://m.aguywithascarf.com/k.js" data-website-id="60ba3bef-be02-4f7f-8ba8-5fb778e653ac"></script>
<script defer src="https://dataviz.aguywithascarf.com/ver.js"></script><!-- End Umami -->
</head>
<body>

<div id="topbar">
  <!-- The old "NBA <season> · Season Towers" title lived here. The strip's lit Season
       pill and the season switcher beside it now say exactly that, and being nowrap and
       unshrinkable it was pushing the credit off the right edge once the strip grew. -->
  <!-- The same strip as the film, so the bar reads the same on both pages: this view
       first, then the film's four sections, each linked by name. Those four ARE the way
       back into the film, which is why there is no separate "Film" pill. The season
       switcher loses its "Season" label here -- that word now belongs to the pill. -->
  <div class="seg" id="strip"></div>
  <div class="seg" id="seasons"></div>
  <div class="grow"></div>
  <span class="lab">View</span><div class="seg" id="views"></div>
  <div id="credit">Produced with passion by <b>Carlo De Marchis</b> ·
    <a href="#" onclick="openMod('cmodal');return false">Credits</a><a class="agwas-ver" data-agwas-ver="nba" href="https://dataviz.aguywithascarf.com/releases/#nba" target="_blank" rel="noopener"></a></div>
</div>

<div id="wrap"></div>
<div id="tip"></div>

<div id="ctlbar">
  <button class="ic" title="Restart (Home)" onclick="setG(1)"><svg viewBox="0 0 24 24"><path d="M2 5v6h6"/><path d="M4.6 15.5a8.5 8.5 0 1 0 2-8.8L2 11"/></svg></button>
  <button class="ic" title="Previous game (←)" onclick="setG(G-1)"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button>
  <button class="ic" id="playb" title="Play the season (space)" onclick="togglePlay()"><svg viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z"/></svg></button>
  <button class="ic" title="Next game (→)" onclick="setG(G+1)"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
  <button class="ic" title="Whole season (End)" onclick="setG(MAXG)"><svg viewBox="0 0 24 24"><path d="M7 6l8 6-8 6z"/><path d="M18 5v14"/></svg></button>
  <div class="scrub"><input type="range" id="slider" min="1" max="82" value="82"
    aria-label="Game number"><span id="gdot" aria-hidden="true"></span></div>
  <div id="gno"></div>
  <button class="ic" title="More sports experiences" onclick="openMod('mmodal')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button>
  <button class="ic" title="Help (h)" onclick="openMod('hmodal')"><svg viewBox="0 0 24 24"><path d="M12 17h.01M9.1 9a3 3 0 1 1 4.2 2.7c-.8.4-1.3 1.1-1.3 2"/></svg></button>
  <button class="ic" title="Fullscreen (f)" onclick="fs()"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 15v5h-5M15 4h5v5M9 20H4v-5"/></svg></button>
</div>

<div class="mod" id="hmodal" onclick="if(event.target===this)closeMods()">
  <div class="mbox" onclick="event.stopPropagation()">
    <h3>How to read this</h3>
    <p>The <b>playoff race</b>, game by game. Each bar is a team's <b>wins</b>; the
      stripes behind it run on to the most it can still reach. All bars share one 82-game
      scale, so they are comparable across the page and never rescale.</p>
    <ul>
      <li><b>Two lines per conference</b>, because the NBA has two cuts: seeds one to six
        go straight to the playoffs, seven to ten go to the play-in. The dashed marks in
        the bars sit at the wins of the sixth and tenth teams.</li>
      <li>Teams are <b>ranked by win percentage</b>, as the NBA ranks them — so a team with
        games in hand can sit above a longer bar. Hover a team for how many games it is
        ahead of or behind each line.</li>
      <li>A team <b>fades</b> once ten teams in its conference already have more wins than
        it can still reach — it cannot make the play-in, whatever the tiebreaks. A tag
        fills in once a place is <b>clinched</b> on the same arithmetic.</li>
      <li>Tags and lines appear once every team has played. On the final night the order
        is the official one, tiebreakers included.</li>
      <li><b>Games</b> lays out every game of every team, one row each: a green box
        for a win, red for a loss, the opponent's letters inside. Hover a game for the
        score.</li>
      <li><b>Bracket</b> shows how the playoffs went. The <b>NBA Cup Championship</b> does
        not count toward a team's record, so it is not in the race.</li>
    </ul>
    <p><kbd>←</kbd> <kbd>→</kbd> step a game · <kbd>space</kbd> play ·
      <kbd>Home</kbd> <kbd>End</kbd> ends · <kbd>f</kbd> fullscreen ·
      <kbd>h</kbd> help · <kbd>Esc</kbd> close.</p>
  <p class="agwas-rel"><a href="https://dataviz.aguywithascarf.com/releases/#nba" target="_blank" rel="noopener">Release notes</a> <a class="agwas-ver" data-agwas-ver="nba" href="https://dataviz.aguywithascarf.com/releases/#nba" target="_blank" rel="noopener"></a></p></div>
</div>

<div class="mod" id="cmodal" onclick="if(event.target===this)closeMods()">
  <div class="mbox" onclick="event.stopPropagation()">
    <h3>Credits &amp; sources</h3>
    <p>Built by <b>Carlo De Marchis</b> — <i>A Guy With A Scarf</i>. A showcase piece,
      not a commercial product.</p>
    <ul>
      <li><b>Schedule and results</b> — ESPN's public API. Records reconciled against
        the official standings for all 30 teams.</li>
      <li><b>Crests</b> — official NBA artwork from cdn.nba.com.</li>
      <li>The race shows the 82-game regular season only; the playoffs are in the
        Bracket and on the team cards in the Film.</li>
    </ul>
  </div>
</div>

<div class="mod" id="mmodal" onclick="if(event.target===this)closeMods()">
  <div class="mbox" style="width:min(430px,94vw)" onclick="event.stopPropagation()">
    <h3>More sports experiences</h3>
    <div class="applist" id="applist"></div>
    <p style="margin-top:12px"><a href="https://dataviz.aguywithascarf.com"
      target="_blank" rel="noopener">See them all →</a></p>
  </div>
</div>

<script>
const D = /*__DATA__*/{};
const SEASON = D.season;
const TEAMS = D.teams;
/* Counting games only: the NBA Cup final sits outside the record, so it must not
   appear in a tower that IS the record -- and it must not stretch the slider to 83. */
const counting = t => t.games.filter(g => g.counts !== false);
const MAXG = Math.max(...TEAMS.map(t => counting(t).length), 1);

/* Several primaries are near-black (Brooklyn and San Antonio are #000000 exactly), which
   is invisible on this background. Prefer the team's SECONDARY when the primary is too
   dark and the secondary is clearly brighter -- that is usually the colour the team is
   actually recognised by anyway (Pacers gold, Suns orange, Spurs silver). Only if both
   are dark do we artificially lift. */
function lum(hex){
  const m = /^#?([0-9a-f]{6})$/i.exec(hex || '');
  if (!m) return null;
  const n = parseInt(m[1], 16);
  return (0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255)) / 255;
}
function lift(hex){
  const m = /^#?([0-9a-f]{6})$/i.exec(hex);
  const n = parseInt(m[1], 16);
  let r = n >> 16, g = (n >> 8) & 255, b = n & 255;
  const L = Math.max(lum(hex), 0.02), k = 0.30 / L;
  r = Math.min(255, Math.round(r * k + 62));
  g = Math.min(255, Math.round(g * k + 62));
  b = Math.min(255, Math.round(b * k + 62));
  return `rgb(${r},${g},${b})`;
}
function winColor(t){
  const p = lum(t.primary), sec = lum(t.secondary);
  if (p === null) return 'var(--win)';
  if (p >= 0.22) return t.primary;
  if (sec !== null && sec > p + 0.12) return t.secondary;
  return lift(t.primary);
}

const crest = ab => `img/crest/${ab}.svg`;
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g,
  c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const sgn = n => (n > 0 ? '+' : '') + n;

const PREF = {
  get(k, d){ try { return localStorage.getItem('nbatow.' + k) ?? d; } catch(e){ return d; } },
  set(k, v){ try { localStorage.setItem('nbatow.' + k, v); } catch(e){} }
};

let G     = MAXG;
let playing = null;

function recordAt(t, n){
  const gs = counting(t).slice(0, n);
  let w = 0, l = 0, todo = 0;
  // `todo` is games inside the window that have NOT been played -- those are what hang
  // from the ceiling. Counting games BEYOND the window instead left an unplayed season
  // drawing nothing at all, because slicing 80 of 80 leaves no remainder.
  gs.forEach(g => { if (g.res === 'W') w++; else if (g.res === 'L') l++; else todo++; });
  return {w, l, todo, played: w + l};
}

function draw(){
  if (VIEW === 'bracket') return;      // the bracket owns #wrap while it is up
  document.getElementById('wrap').innerHTML = VIEW === 'reg' ? regHtml() : raceHtml();
  gnoLabel();
}



/* How far the slider can go. In a season under way that is the most games any team has
   played -- a shared link from last season (#race/conf/82) must not open a new season at
   game 82, drawing games that have not happened. Unplayed or finished: the lot. */
const LASTG = Math.max(0, ...TEAMS.map(t => counting(t).filter(g => g.res).length));
const CAP = LASTG > 0 && LASTG < MAXG ? LASTG : MAXG;
function setG(n){
  G = Math.max(1, Math.min(CAP, n));
  document.getElementById('slider').value = G;
  paintScrub();
  draw();
  syncHash();
}
/* Puts the game number on the slider thumb and fills the track behind it. The thumb
   centre travels from half a thumb in to half a thumb short of the end, so the label
   has to follow that inset rather than a plain 0-100% of the track. */
const THUMB = 24;
function paintScrub(){
  const sl = document.getElementById('slider'), dot = document.getElementById('gdot');
  if (!sl || !dot) return;
  const pct = MAXG > 1 ? (G - 1) / (MAXG - 1) : 1;
  sl.style.setProperty('--pct', pct);
  dot.style.left = (THUMB / 2 + pct * (sl.clientWidth - THUMB)) + 'px';
  dot.textContent = G;
}
addEventListener('resize', paintScrub);
/* Standing rule in this family: a reload lands exactly where you were, never at the
   start, and the address bar is always shareable. */
function syncHash(){
  const want = VIEW === 'bracket' ? '#bracket'
    : VIEW === 'reg' ? `#reg/${G}` : `#race/${RACETAB}/${G}`;
  if (location.hash !== want) history.replaceState(null, '', want);
  PREF.set('game', G);
  updateSocialMeta();
}

/* The capture extension reads these when the shortcut is pressed, so they describe the
   view on screen -- which grouping, and how far through the season the slider is.
   syncHash() is the one place every change passes through. */
function socMeta(name, content){
  let m = document.head.querySelector('meta[name="' + name + '"]');
  if (!m){ m = document.createElement('meta'); m.setAttribute('name', name); document.head.appendChild(m); }
  m.setAttribute('content', content);
}
function updateSocialMeta(){
  try {
    // The keys are the app's own: league / conf / div. Spelling them out here as
    // "conference" and "division" silently fell through to the league wording.
    if (VIEW === 'bracket'){
      const f = BSER[BSER.length - 1];
      const ch = f && (f.aw > f.bw ? f.a : f.b);
      socMeta('agwas:title', `NBA Playoffs ${SEASON}`);
      socMeta('agwas:cta', (ch
        ? `${ch.name} came out of the ${SEASON} bracket as champions`
        : `The ${SEASON} playoff bracket`) + ' — full interactive experience below');
      socMeta('agwas:tags', 'nba dataviz playoffs bracket');
      socMeta('agwas:mentions', 'nba');
      return;
    }
    if (VIEW === 'reg'){
      socMeta('agwas:title', `NBA Regular Season, ${SEASON}`);
      socMeta('agwas:cta', `Every game of the ${SEASON} NBA regular season, team by team`
        + (G >= CAP ? '' : ` — after game ${G}`) + ' — full interactive experience below');
      socMeta('agwas:tags', 'nba dataviz basketball schedule results');
      socMeta('agwas:mentions', 'nba');
      return;
    }
    socMeta('agwas:title', `NBA Playoff Race, ${SEASON}`);
    socMeta('agwas:cta', `The ${SEASON} NBA playoff race` + (G >= CAP ? '' : ` after game ${G}`)
      + ' — full interactive experience below');
    socMeta('agwas:tags', 'nba dataviz basketball playoffrace standings');
    socMeta('agwas:mentions', 'nba');
  } catch(e) {}
}
function readHash(){
  if ((location.hash || '') === '#bracket') return {view: 'bracket'};
  const gm = /^#reg\/(\d+)$/.exec(location.hash || '');
  if (gm) return {view: 'reg', g: +gm[1]};
  const rm = /^#race\/(?:(conf|div|league)\/)?(\d+)$/.exec(location.hash || '');
  if (rm) return {view: 'race', tab: rm[1], g: +rm[2]};
  // The towers are gone. A link made for them (#conf/82, #div/40, or the older
  // #league/wins/82) opens the race at the same game, on the tab that has the same name
  // as the grouping it asked for.
  const m = /^#(league|conf|div)\/(?:[a-z]+\/)?(\d+)$/.exec(location.hash || '');
  if (!m) return null;
  return {view: 'race', tab: m[1], g: +m[2]};
}
document.getElementById('slider').max = MAXG;
paintScrub();
document.getElementById('slider').addEventListener('input', e => setG(+e.target.value));

function togglePlay(){
  const b = document.getElementById('playb');
  if (playing){ clearInterval(playing); playing = null;
    b.innerHTML = '<svg viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z"/></svg>'; return; }
  if (G >= CAP) setG(1);
  playing = setInterval(() => { if (G >= CAP) return togglePlay(); setG(G + 1); }, 140);
  b.innerHTML = '<svg viewBox="0 0 24 24"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>';
}

/* segmented controls */
function seg(host, items, current, onPick){
  document.getElementById(host).innerHTML = items.map(([v, l]) =>
    `<button class="pill ${v === current ? 'on' : ''}" data-v="${v}">${l}</button>`).join('');
  document.getElementById(host).onclick = e => {
    const b = e.target.closest('[data-v]'); if (!b) return; onPick(b.dataset.v);
  };
}
/* ---------- the playoff bracket ----------

   Rebuilt from the same per-team `po` blocks the cards use rather than shipped as its
   own structure: every series is in there twice, once from each side, so it is a matter
   of pairing them up and deciding which way round to draw each one.

   Orientation is by seed, higher first. The Finals is the one series where the two come
   from different conferences and both can be a 1 seed, so it falls back to the better
   regular-season record -- which is also who had home court. */
const PO_ROUNDS = ['1st Round', 'Semifinals', 'Conference Finals', 'NBA Finals'];
/* Where each first-round series sits, top to bottom, in a conference's half. Not seed
   order: the 1 seed and the 4/5 series share the top half of the bracket, which is why
   4 comes second and 2 last. */
const R1ORDER = [1, 4, 3, 2];
let BSER = [];                 // flattened, so a game chip can point back at its series

function seriesAll(){
  const seen = new Set(), out = [[], [], [], []];
  TEAMS.forEach(t => {
    if (!t.po) return;
    (t.po.rounds || []).forEach(r => {
      const ri = PO_ROUNDS.indexOf(r.round);
      if (ri < 0 || !r.opp) return;
      const key = ri + ':' + [t.abbr, r.opp].sort().join('|');
      if (seen.has(key)) return;
      seen.add(key);
      const o = TEAMS.find(x => x.abbr === r.opp);
      if (!o) return;
      const flip = (o.seed || 99) < (t.seed || 99) ||
                   ((o.seed || 99) === (t.seed || 99) && o.w > t.w);
      // The games are recorded from the side whose block we read, so flipping the series
      // flips every one of them: result, score and venue.
      out[ri].push(flip
        ? {a: o, b: t, aw: r.l, bw: r.w, round: r.round,
           games: (r.games || []).map(g => ({res: g.res === 'W' ? 'L' : 'W',
             us: g.them, them: g.us, ha: g.ha === 'H' ? 'A' : 'H', date: g.date}))}
        : {a: t, b: o, aw: r.w, bw: r.l, round: r.round, games: r.games || []});
    });
  });
  return out;
}

function bracketHtml(){
  const R = seriesAll();
  BSER = [];
  if (!R[0].length) return `<p class="brnone">No playoffs in ${esc(SEASON)} yet — the
    bracket fills in once the postseason is played.</p>`;

  const FIN = R[3][0];
  const CHAMP = FIN && (FIN.aw === 4 || FIN.bw === 4)
    ? (FIN.aw > FIN.bw ? FIN.a : FIN.b) : null;

  // A fixed order, so the two sides do not swap between seasons.
  const sides = [['West', 'l'], ['East', 'r']].filter(c => R[0].some(s => s.a.conf === c[0]));
  const r1 = {}, slotOf = {};
  sides.forEach(([c]) => {
    r1[c] = R[0].filter(s => s.a.conf === c)
      .sort((x, y) => R1ORDER.indexOf(x.a.seed) - R1ORDER.indexOf(y.a.seed));
    r1[c].forEach((s, i) => { slotOf[s.a.abbr] = i; slotOf[s.b.abbr] = i; });
  });
  // A later series sits where its feeders did: halve the first-round slot once per round.
  const slotFor = (s, ri) => ri === 0
    ? (r1[s.a.conf] || []).indexOf(s)
    : Math.floor((slotOf[s.a.abbr] != null ? slotOf[s.a.abbr]
                                           : slotOf[s.b.abbr] || 0) / Math.pow(2, ri));

  // The centre line of slot i in a round that has 8/span slots.
  const at = (slot, ri) => (slot + .5) * Math.pow(2, ri + 1) / 8 * 100;
  const winnerOf = s => s.aw === 4 || s.bw === 4 ? (s.aw > s.bw ? s.a : s.b) : null;
  const pips = (s, si) => `<div class="sgames">${s.games.map((g, i) => {
    const win = g.res === 'W' ? s.a : s.b;
    return `<i class="pog" data-s="${si}" data-i="${i}"
      style="background:${winColor(win)}"></i>`;
  }).join('')}</div>`;

  /* One composition for every round: the two crests facing, the score between them.
     `fin` only adds the conference and seed under each name -- there is room for it
     there and nowhere else. */
  const duel = (s, fin) => {
    const won = winnerOf(s);
    const sideOf = t => `<div class="dside ${won && t !== won ? 'out' : ''}">
      <img src="${crest(t.abbr)}" alt="" loading="lazy">
      <b>${esc(fin ? t.nick : t.abbr)}</b>
      <i>${fin ? `${esc(t.conf)} ${t.seed || ''} seed` : `${t.seed || ''}`}</i></div>`;
    const score = `<div class="dsc"><span class="${won === s.b ? 'l' : ''}">${s.aw}</span>
      <em>&ndash;</em><span class="${won === s.a ? 'l' : ''}">${s.bw}</span></div>`;
    // In a column the score sits between the crests, because that is the only width
    // there is. The Finals has the whole middle of the page: the two crests take it
    // all and the score goes underneath, as big as a title card.
    return fin
      ? `<div class="finkick">NBA Finals</div>
         <div class="duel fin">${sideOf(s.a)}${sideOf(s.b)}</div>${score}`
      : `<div class="duel">${sideOf(s.a)}${score}${sideOf(s.b)}</div>`;
  };

  const ser = (s, ri) => {
    const si = BSER.push(s) - 1;
    const won = winnerOf(s);
    // the wash rises from under whichever crest won, so the box leans his way
    const cx = won ? (won === s.a ? '16%' : '84%') : '50%';
    const fin = ri === 3;
    const road = CHAMP && !fin && (s.a === CHAMP || s.b === CHAMP);
    return `<div class="ser ${fin ? 'fin' : ''} ${road ? 'road' : ''}" data-s="${si}"
      style="${fin ? '--cr:min(17vh,9vw,188px)' : `top:${at(slotFor(s, ri), ri).toFixed(3)}%`
        }${won ? `;--c:${winColor(won)};--cx:${cx}` : ''}">
      ${duel(s, fin)}
      ${pips(s, si)}</div>`;
  };

  const RN = ['1st Round', 'Semifinals', 'Conf. Finals'];
  const col = (list, ri) => {
    let deco = '';
    list.forEach(x => {
      const slot = slotFor(x, ri);
      const w = x.aw === 4 || x.bw === 4 ? (x.aw > x.bw ? x.a : x.b) : null;
      const gold = CHAMP && (x.a === CHAMP || x.b === CHAMP);
      deco += `<i class="brstub ${gold ? 'road' : ''}" style="top:${at(slot, ri).toFixed(3)}%${
        w ? `;--c:${gold ? 'var(--gold)' : winColor(w)}` : ''}"></i>`;
      // The vertical joins a pair inside this column. The conference finals have no
      // partner here -- their pair IS the NBA Finals, on the other side of the page.
      if (ri < 2 && slot % 2 === 0)
        deco += `<i class="brjoin" style="top:${at(slot, ri).toFixed(3)}%;height:${
          (at(slot + 1, ri) - at(slot, ri)).toFixed(3)}%"></i>`;
    });
    return `<div class="brcol r${ri}" data-r="${esc(RN[ri])}">${deco}${
      list.map(x => ser(x, ri)).join('')}</div>`;
  };
  const side = ([conf, cls]) => {
    const cols = [0, 1, 2].map(ri =>
      col(ri === 0 ? r1[conf] : R[ri].filter(s => s.a.conf === conf), ri));
    // The right-hand side reads inward, so its rounds run the other way.
    return `<div class="brside ${cls}" data-conf="${esc(conf)}">${
      (cls === 'r' ? cols.reverse() : cols).join('')}</div>`;
  };

  const head = `<div class="brhd">
    <div>${RN.map(r => `<span>${r}</span>`).join('')}</div>
    <span class="fin">NBA Finals</span>
    <div>${[...RN].reverse().map(r => `<span>${r}</span>`).join('')}</div></div>`;

  const finals = FIN, champ = CHAMP;
  return head + `<div class="brack">
    ${champ ? `<img class="brwash" src="${crest(champ.abbr)}" alt="">` : ''}
    ${sides[0] ? side(sides[0]) : '<div></div>'}
    <div class="brfin">
      ${finals ? ser(finals, 3) : ''}
      ${champ ? `<div class="brchamp">
        <div class="ttl"><span class="ring">&#9679;</span>${esc(champ.name)}</div>
        <div class="sub">${esc(SEASON)} champions &middot; ${champ.w}-${champ.l} &middot;
          ${esc(champ.conf)} ${champ.seed} seed</div></div>` : ''}
    </div>
    ${sides[1] ? side(sides[1]) : '<div></div>'}
  </div>
  <div class="brcap">Higher seed on the left of each series · the beaten crest greys out ·
    a game takes the colour of the team that won it${CHAMP
      ? ' · the gold thread is the champion\u2019s road' : ''} · hover a game for the score</div>`;
}

/* ---------- the playoff race ----------
   The NHL season page's race, adapted to the NBA's rules. Three differences carry it:
   - WINS, not points. There is no overtime-loss column in the NBA, so a bar is wins and
     its ghost is the games left.
   - TWO CUTS. Seeds one to six are in the playoffs, seven to ten go to the play-in, the
     rest are done. Two lines per conference, not one.
   - RANKED BY WIN PERCENTAGE, which is how the NBA ranks -- so a team with games in hand
     can sit above a longer bar, and distance to a line is given in games behind, the
     NBA's own unit. On the final night the order is the official seeding instead, which
     carries the tiebreakers this page cannot see. */
const GAMES = 82;   // the season's length, not the games published: 2026-27 lists 80 until the Cup
const pctOf = r => r.played ? r.w / r.played : 0;
const byPct = (a, b) => pctOf(b) - pctOf(a) || b.w - a.w || a.l - b.l
  || a.t.nick.localeCompare(b.t.nick);
// How many games `a` is behind `b`: half the swing in wins plus half the swing in losses.
const gbehind = (a, b) => ((b.w - a.w) + (a.l - b.l)) / 2;
const SEASON_DONE = TEAMS.length > 0 && TEAMS.every(t => counting(t).every(g => g.res));
const CONFS = [['East', 'Eastern Conference'], ['West', 'Western Conference']];
const DIVS = {East: ['Atlantic', 'Central', 'Southeast'],
              West: ['Northwest', 'Pacific', 'Southwest']};
let RACEROWS = {};

function raceConf(conf, n){
  const rows = TEAMS.filter(t => t.conf === conf).map(t => {
    const r = recordAt(t, n), left = Math.max(0, GAMES - r.played);
    return {t, ...r, left, max: r.w + left};
  });
  // "If the season ended today" means nothing until everyone has played: on opening night
  // the places are 0-0 ties broken by the alphabet. No tags and no lines until then.
  const ready = rows.length > 0 && rows.every(r => r.played > 0);
  const done = SEASON_DONE && n >= MAXG;
  rows.sort(done ? (a, b) => (a.t.seed || 99) - (b.t.seed || 99) : byPct);
  rows.forEach((r, i) => {
    r.seed = i + 1;
    r.tag = ready && i < 10 ? conf[0] + (i + 1) : null;
    r.pi = i >= 6 && i < 10;
    r.champ = done && r.t.po && r.t.po.outcome === 'CHAMPIONS';
  });
  rows.forEach(r => {
    const rivals = rows.filter(o => o !== r);
    // Out when ten rivals already have more wins than it can still reach -- there are
    // ten places in the play-in, so that is certain, whatever the tiebreaks. Clinched on
    // the same arithmetic the other way round: few enough rivals can still catch it.
    // Both use wins, because everyone ends on 82 games and then wins ARE the order.
    const threats = rivals.filter(o => o.max >= r.w).length;
    r.out = done ? r.seed > 10 : rivals.filter(o => o.w > r.max).length >= 10;
    r.clinchPO = ready && (done ? r.seed <= 6 : threats <= 5);
    r.clinchPI = ready && (done ? r.seed <= 10 : threats <= 9);
  });
  const six = rows[5], ten = rows[9];
  return {rows, ready, six, ten,
          cutPO: ready && six ? six.w : null, cutPI: ready && ten ? ten.w : null};
}

function raceHtml(){
  const SC = GAMES;                          // every win there is: the bars never rescale
  const pc = v => (Math.max(0, v) / SC * 100).toFixed(2);
  const ticks = [0, 10, 20, 30, 40, 50, 60, 70, 80]
    .map(v => `<span style="left:${pc(v)}%">${v}</span>`).join('');
  /* The wins chip sits just past the solid bar; the ceiling chip inside the end of the
     stripes -- when there is room for both. Late in a season the stripes shrink to a
     sliver, and then the two share one chip rather than piling up. */
  const labels = r => {
    const room = r.left / SC * 100;
    const at = `left:calc(${pc(r.w)}% + 5px)`;
    if (!r.left) return `<b class="rcpts" style="${at}">${r.w}<small>W</small></b>`;
    if (room < 26) return `<b class="rcpts" style="${at}">${r.w}<small>W</small>
      <span class="rcmaxin">· max ${r.max}</span></b>`;
    return `<b class="rcpts" style="${at}">${r.w}<small>W</small></b>
      <b class="rcmax" style="right:calc(${(100 - +pc(r.max)).toFixed(2)}% + 4px)"
        title="the most wins it can still reach">max ${r.max}</b>`;
  };
  RACEROWS = {};
  const axis = `<div class="rcrow" style="flex:0 0 auto;min-height:0"><span></span><span></span><span></span>
        <span class="rcaxis">${ticks}</span><span class="rec" style="font-size:9px;letter-spacing:.08em;
          color:var(--dim)">W-L</span><span></span></div>`;
  const row = (r, rank, c, lines) => {
    const tag = r.tag ? `<span class="tag${r.pi ? ' pi' : ''}">${r.tag}</span>`
                      : '<span class="tag none">–</span>';
    return `<div class="rcrow${r.out ? ' out' : ''}${r.clinchPO ? ' clinched' : ''}${
        r.champ ? ' champ' : ''}" data-ab="${r.t.abbr}" style="--c:${winColor(r.t)}">
      <span class="rk">${rank}</span>
      <img src="${crest(r.t.abbr)}" alt="" loading="lazy">
      <span class="nm">${esc(r.t.nick)}${r.champ ? ' ★' : ''}</span>
      <span class="rcbar">
        <i class="gh" style="left:${pc(r.w)}%;width:${pc(r.left)}%"></i>
        <i class="w" style="left:0;width:${pc(r.w)}%"></i>
        ${lines && c.cutPI != null ? `<i class="cut pi" style="left:${pc(c.cutPI)}%"></i>` : ''}
        ${lines && c.cutPO != null ? `<i class="cut" style="left:${pc(c.cutPO)}%"></i>` : ''}
        ${labels(r)}
      </span>
      <span class="rec">${recHtml(r)}</span>${tag}
    </div>`;
  };
  const subhd = txt => `<div class="rcsub">${txt}</div>`;
  const sep = (txt, pi) => `<div class="rcsep${pi ? ' pi' : ''}"><span>${txt}</span></div>`;
  // The lines are records, not win totals: mid-season the teams have played different
  // numbers of games, and "sixth is 30-14" says what a bare 30 cannot.
  const lineNote = c => !c.ready ? 'places and lines appear once every team has played'
    : `playoff line <b>${c.six.w}-${c.six.l}</b> <em>· play-in</em> <b>${c.ten.w}-${c.ten.l}</b>`;
  const panel = (title, note, inner) => `<div class="rcconf">
      <div class="rchd"><span>${title}</span><span class="rcline">${note}</span></div>
      ${axis}<div class="rcrows">${inner}</div></div>`;

  const C = {};
  CONFS.forEach(([k]) => {
    C[k] = raceConf(k, G);
    C[k].rows.forEach(r => { RACEROWS[r.t.abbr] = {r, c: C[k]}; });
  });

  let cols;
  if (RACETAB === 'div'){
    // Divisions have not decided seeding since 2016, so no line runs through them; the
    // tag is still the team's place in its conference.
    cols = CONFS.map(([k, title]) => panel(title, lineNote(C[k]),
      DIVS[k].map(d => subhd(d) + C[k].rows.filter(r => r.t.div === d)
        .map((r, i) => row(r, i + 1, C[k], false)).join('')).join('')));
  } else if (RACETAB === 'league'){
    // The race for the best record -- home court through the playoffs. No line: places
    // are won within a conference, so one cut through all thirty would be wrong for half.
    const all = C.East.rows.concat(C.West.rows).sort(byPct);
    cols = [all.slice(0, 15), all.slice(15)].map((part, k) => panel(
      k ? 'League · 16–30' : 'League · 1–15', k ? '' : 'no line: places are won within a conference',
      part.map((r, i) => row(r, k * 15 + i + 1, C[r.t.conf], false)).join('')));
  } else {
    cols = CONFS.map(([k, title]) => {
      const c = C[k];
      return panel(title, lineNote(c), c.rows.map((r, i) => row(r, i + 1, c, true)
        + (c.ready && i === 5 ? sep('playoff line') : '')
        + (c.ready && i === 9 ? sep('play-in line', true) : '')).join(''));
    });
  }

  const NOTE = {
    conf: `Each conference ranked by win percentage, as the NBA seeds it. The top six are in
      the playoffs; seven to ten go to the play-in — the two dashed lines.`,
    div: `Each conference by its three divisions. Divisions no longer decide seeding, so no
      line runs through them; the tag is still the team's place in its conference.`,
    league: `All thirty teams by win percentage — the race for the best record, and home
      court all the way through the playoffs.`,
  }[RACETAB];
  const any = TEAMS.some(t => counting(t).some(g => g.res));
  return `<div class="rchead">
      <h2>The playoff race${!any ? '' : SEASON_DONE && G >= MAXG ? ', final'
        : G >= CAP ? ', tonight' : `, after game ${G}`}</h2>
      <div class="seg rctabs">${RACETABS.map(([k, l]) =>
        `<button class="pill ${k === RACETAB ? 'on' : ''}" onclick="setRaceTab('${k}')">${l}</button>`).join('')}</div>
      <div class="rckey">
        <span><i style="background:var(--acc)"></i>wins</span>
        <span><i style="background:repeating-linear-gradient(135deg,rgba(224,69,63,.38) 0 3px,transparent 3px 6px)"></i>still possible</span>
        <span><i style="background:none;border-left:1.5px dashed var(--ink);width:6px;border-radius:0"></i>playoff line</span>
        <span><i style="background:none;border-left:1.5px dashed rgba(232,236,245,.35);width:6px;border-radius:0"></i>play-in line</span>
      </div>
      <p>${NOTE.replace(/\s+/g, ' ')}${!any ? ` The ${esc(SEASON)} season has not started:
        every bar is still all stripes, and the race fills in as it is played.` : ` The stripes run
        on to the most wins a team can still reach; once ten teams in its conference are beyond
        that, it cannot make the play-in, and fades.`}</p>
    </div>
    <div class="rcgrid">${cols.join('')}</div>`;
}
const RACETABS = [['conf', 'Conference'], ['div', 'Division'], ['league', 'League']];
let RACETAB = RACETABS.some(x => x[0] === PREF.get('racetab', 'conf'))
  ? PREF.get('racetab', 'conf') : 'conf';
function setRaceTab(k){
  if (!RACETABS.some(x => x[0] === k)) return;
  RACETAB = k; PREF.set('racetab', k);
  draw(); syncHash();
}
function gnoLabel(){
  document.getElementById('gno').innerHTML = LASTG
    ? `game <b>${G}</b> of ${MAXG}` : `<b>${MAXG}</b> games scheduled`;
}

/* The record, with the larger of its two numbers in white -- wins for a winning team,
   losses for a losing one, so the column says at a glance which way a season went.
   Level records light both, except 0-0, which says nothing yet. */
const recHtml = r => r.w > r.l ? `<b>${r.w}</b>-${r.l}`
  : r.l > r.w ? `${r.w}-<b>${r.l}</b>`
  : r.w ? `<b>${r.w}</b>-<b>${r.l}</b>` : `${r.w}-${r.l}`;

/* ---------- the regular season, every game ---------- */
let REGROWS = {};
function regHtml(){
  const N = MAXG;
  REGROWS = {};
  const ticks = [1, 10, 20, 30, 40, 50, 60, 70, 80].filter(v => v <= N)
    .map(v => `<span style="left:${((v - .5) / N * 100).toFixed(2)}%">${v}</span>`).join('');
  const axis = `<div class="rgaxis"><span></span><span></span><span></span><span></span>
    <div class="tx">${ticks}</div></div>`;
  const row = (r, rank) => {
    const games = counting(r.t);
    REGROWS[r.t.abbr] = {r, games};
    const cells = Array.from({length: N}, (_, i) => {
      const g = games[i];
      if (!g) return '<span class="rgc u"></span>';
      // Past the slider, a game has not happened yet -- whatever the final result was.
      const k = i < G && g.res ? (g.res === 'W' ? 'w' : 'l') : 'u';
      return `<span class="rgc ${k}" data-i="${i}">${esc(String(g.opp || '').slice(0, 3))}</span>`;
    }).join('');
    return `<div class="rgrow${r.champ ? ' champ' : ''}" data-ab="${r.t.abbr}">
      <span class="rk">${rank}</span>
      <img src="${crest(r.t.abbr)}" alt="" loading="lazy">
      <a class="ab" href="index-${SEASON}.html#team-${r.t.abbr}"
        title="${esc(r.t.name)} — open the team card">${esc(r.t.abbr)}${r.champ ? '★' : ''}</a>
      <span class="rec">${recHtml(r)}</span>
      <span class="rgcells" style="--n:${N}">${cells}</span></div>`;
  };
  // Same order as the race at the same game, so switching views never reshuffles.
  const body = CONFS.map(([k, title]) =>
    `<div class="rgconf">${title}</div>` + raceConf(k, G).rows.map((r, i) => row(r, i + 1)).join('')
  ).join('');
  const any = TEAMS.some(t => counting(t).some(g => g.res));
  return `<div class="rghead">
      <h2>The regular season${!any ? '' : SEASON_DONE && G >= MAXG ? '' : G >= CAP ? ', so far'
        : `, after game ${G}`}</h2>
      <p>${any ? 'Every game, every team — in standings order.'
        : `Every game on the ${esc(SEASON)} schedule, waiting to be played.`}</p>
      <div class="rgkey">
        <span><i style="background:color-mix(in srgb,var(--win) 70%,#000)"></i>win</span>
        <span><i style="background:color-mix(in srgb,var(--loss) 80%,#000)"></i>loss</span>
        <span><i style="background:rgba(150,166,205,.18)"></i>to play</span>
        <span>letters = the opponent</span>
      </div>
    </div>${axis}<div class="rggrid">${body}</div>`;
}

/* ---------- which view ---------- */
// A browser that last had the towers open remembers 'towers'; that view is gone.
const VIEWS = [['race', 'Race'], ['reg', 'Games'], ['bracket', 'Bracket']];
let VIEW = VIEWS.some(v => v[0] === PREF.get('view', 'race')) ? PREF.get('view', 'race') : 'race';
function drawViews(){
  seg('views', VIEWS, VIEW, v => {
    VIEW = v; PREF.set('view', v); drawViews(); applyView();
  });
}
function applyView(){
  document.body.classList.toggle('bracket', VIEW === 'bracket');
  document.body.classList.toggle('race', VIEW === 'race');
  document.body.classList.toggle('reg', VIEW === 'reg');
  if (VIEW === 'bracket') document.getElementById('wrap').innerHTML = bracketHtml();
  else draw();
  syncHash();
}

drawViews();

document.getElementById('strip').innerHTML =
  `<span class="pill on">Season</span>` +
  [['Players','players'], ['Player stats','player-stats'],
   ['Teams','teams'], ['Team stats','team-stats']].map(([n, slug]) =>
    `<a class="pill" href="index-${SEASON}.html#${slug}">${n}</a>`).join('');

document.getElementById('seasons').innerHTML = (D.seasons || [SEASON]).map(s =>
  s === SEASON ? `<span class="pill on">${s}</span>`
               : `<a class="pill" href="towers-${s}.html">${s}</a>`).join('');

function fs(){
  document.fullscreenElement ? document.exitFullscreen()
    : document.documentElement.requestFullscreen().catch(()=>{});
}
function openMod(id){ closeMods(); document.getElementById(id).classList.add('on'); }
function closeMods(){ document.querySelectorAll('.mod').forEach(m=>m.classList.remove('on')); }

/* The family cross-link panel; every app's list leaves out itself. */
const APPS = [
  ['Formula 1','A season read lap by lap','#00d7b6','https://f1.aguywithascarf.com'],
  ['Tennis','The season, one player at a time','#f2c14e','https://tennis.aguywithascarf.com'],
  ['Football','Season towers, top 5 leagues','#2f9e58','https://top5.aguywithascarf.com'],
  ['NFL','Wins up, losses down','#4d94e0','https://nfl.aguywithascarf.com'],
  ['NHL','Season film and towers','#2a9fd8','https://nhl.aguywithascarf.com'],
  ['World Cup','Road to the Final','#3fbe72','https://worldcupbracket.aguywithascarf.com'],
  ['PGA TOUR','Season Film','#57a34a','https://golf.aguywithascarf.com'],
  ['Athletics','World Record Film','#d98a3d','https://athletics.aguywithascarf.com']
];
document.getElementById('applist').innerHTML = APPS.map(a =>
  `<a class="approw" href="${a[3]}" target="_blank" rel="noopener">
    <i style="background:${a[2]}"></i><span>${a[0]}<em>${a[1]}</em></span><span>\u2197</span></a>`).join('');

/* hover tooltip on a tower */
const tip = document.getElementById('tip');
function placeTip(e){
  const pad = 14;
  tip.classList.add('on');
  tip.style.left = Math.min(e.clientX + pad, innerWidth - tip.offsetWidth - 8) + 'px';
  tip.style.top  = Math.min(e.clientY + pad, innerHeight - tip.offsetHeight - 8) + 'px';
}
const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const WHEN = d => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(d || '');
  return m ? `${+m[3]} ${MON[+m[2] - 1]} ${m[1]}` : '';
};
document.getElementById('wrap').addEventListener('mousemove', e => {
  if (VIEW === 'bracket'){
    const chip = e.target.closest('.pog'), box = e.target.closest('.ser');
    const s = (chip || box) && BSER[+(chip || box).dataset.s];
    if (!s){ tip.classList.remove('on'); return; }
    if (chip){
      const g = s.games[+chip.dataset.i] || {};
      const home = g.ha === 'H' ? s.a : s.b, win = g.res === 'W' ? s.a : s.b;
      tip.innerHTML = `<div class="t">Game ${+chip.dataset.i + 1} · ${esc(s.round)}</div>
        <b>${esc(s.a.abbr)} ${g.us}–${g.them} ${esc(s.b.abbr)}</b>
        <div class="t" style="margin-top:3px">at ${esc(home.abbr)} · ${WHEN(g.date)}</div>
        <div class="t" style="color:${winColor(win)}">${esc(win.nick)} won it</div>`;
    } else {
      const lead = s.aw > s.bw ? s.a : s.b;
      const w = Math.max(s.aw, s.bw), l = Math.min(s.aw, s.bw);
      tip.innerHTML = `<div class="t">${esc(s.round)}</div>
        <b>${esc(s.a.nick)} ${s.aw}–${s.bw} ${esc(s.b.nick)}</b>
        <div class="t" style="margin-top:3px">${w === 4
          ? `${esc(lead.nick)} took it ${w}-${l}` : `${w}-${l}, still going`}</div>`;
    }
    return placeTip(e);
  }
  const cell = e.target.closest('.rgc[data-i]');
  if (cell){
    const hit = REGROWS[cell.closest('.rgrow').dataset.ab];
    const g = hit && hit.games[+cell.dataset.i];
    if (!g){ tip.classList.remove('on'); return; }
    const t = hit.r.t, o = TEAMS.find(x => x.abbr === g.opp) || {nick: g.opp};
    const played = +cell.dataset.i < G && g.res;
    tip.innerHTML = `<div class="t">${esc(t.abbr)} · game ${+cell.dataset.i + 1} · ${WHEN(g.date)}</div>
      <b>${g.ha === 'H' ? 'vs' : 'at'} ${esc(o.nick)}</b>${played
        ? ` · <b style="color:${g.res === 'W' ? 'var(--win)' : 'var(--loss)'}">${g.res} ${g.us}–${g.them}</b>`
        : ' · to play'}
      ${g.note ? `<div class="t" style="margin-top:3px">${esc(g.note)}</div>` : ''}`;
    return placeTip(e);
  }
  const rr = e.target.closest('.rcrow[data-ab]');
  const hit = rr && RACEROWS[rr.dataset.ab];
  if (!hit){ tip.classList.remove('on'); return; }
  const {r, c} = hit, R = c.rows, done = SEASON_DONE && G >= MAXG;
  const n = x => (x % 1 ? x.toFixed(1) : String(x)) + (x === 1 ? ' game' : ' games');
  // Distance to a line, in games behind. Inside it: how far the first team outside is
  // behind you. Outside it: how far you are behind the last team in.
  const line = (k, name) => {
    if (!c.ready || !R[k] || !R[k - 1]) return '';
    const d = r.seed <= k ? gbehind(R[k], r) : gbehind(r, R[k - 1]);
    return d <= 0 ? `level with the ${name}`
      : `${n(d)} ${r.seed <= k ? 'clear of' : 'behind'} the ${name}`;
  };
  const pct = pctOf(r).toFixed(3).replace(/^0/, '');
  const fate = done
    ? (r.t.po ? 'made the playoffs' : r.seed <= 10 ? 'went out in the play-in' : 'missed the play-in')
    : r.clinchPO ? 'clinched a playoff place' : r.clinchPI ? 'clinched at least the play-in'
    : r.out ? 'eliminated' : '';
  tip.innerHTML = `<div class="t">${esc(r.t.conf)} · ${esc(r.t.div)} Division</div>
    <b>${esc(r.t.nick)}</b> ${r.w}-${r.l} · ${pct}
    <div class="t" style="margin-top:3px">${r.left ? `${r.left} to play · could still reach ${r.max} wins`
      : 'season complete'}</div>
    ${c.ready ? `<div class="t">${r.seed}${['st','nd','rd'][((r.seed + 90) % 100 - 10) % 10 - 1] || 'th'} in the
      ${esc(r.t.conf)}${r.tag ? (r.pi ? ' · play-in place' : ' · playoff place') : ''}</div>
    <div class="t">${line(6, 'playoff line')}</div><div class="t">${line(10, 'play-in line')}</div>` : ''}
    ${fate ? `<div class="t" style="color:${r.out || /missed|went out/.test(fate) ? 'var(--loss)' : 'var(--acc)'}">${fate}</div>` : ''}
    ${r.champ ? `<div class="t" style="color:var(--gold)">${esc(r.t.po.outcome)}</div>` : ''}`;
  placeTip(e);
});
document.getElementById('wrap').addEventListener('mouseleave', () => tip.classList.remove('on'));

addEventListener('keydown', e => {
  if (e.key === 'Escape') return closeMods();
  if (document.querySelector('.mod.on')) return;
  if (e.key === 'f') return fs();
  if (e.key === 'h' || e.key === '?') return openMod('hmodal');
  if (e.key === 'ArrowRight') { e.preventDefault(); setG(G + 1); }
  else if (e.key === 'ArrowLeft') { e.preventDefault(); setG(G - 1); }
  else if (e.key === ' ') { e.preventDefault(); togglePlay(); }
  else if (e.key === 'Home') setG(1);
  else if (e.key === 'End') setG(CAP);
  else if (e.key === 'b') { VIEW = VIEW === 'bracket' ? 'race' : 'bracket';
                            PREF.set('view', VIEW); drawViews(); applyView(); }
});

(function start(){
  const h = readHash();
  // #bracket is the whole state that view has; a race link names its tab and its game.
  if (h && h.view === 'bracket'){ VIEW = 'bracket'; drawViews(); return applyView(); }
  if (h){
    // A link that names the race (or the old towers) is a request for it: it beats the
    // view remembered from last time.
    VIEW = h.view === 'reg' ? 'reg' : 'race'; PREF.set('view', VIEW); drawViews();
    if (h.tab){ RACETAB = h.tab; PREF.set('racetab', h.tab); }
    setG(h.g);
  } else {
    let g = CAP;
    try { const saved = +PREF.get('game', CAP); if (saved >= 1 && saved <= CAP) g = saved; }
    catch(e){}
    setG(g);
  }
  // Paints the remembered view -- the race, or the bracket over it.
  applyView();
})();
</script>
</body>
</html>
